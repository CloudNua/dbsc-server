{
  "name": "dbsc-server",
  "version": "0.0.0",
  "description": "Server-side toolkit for Device Bound Session Credentials (DBSC)",
  "license": "MIT",
  "author": "Enda Kelly (https://cloudnua.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CloudNua/dbsc-server.git"
  },
  "homepage": "https://github.com/CloudNua/dbsc-server#readme",
  "bugs": "https://github.com/CloudNua/dbsc-server/issues",
  "keywords": [
    "dbsc",
    "device-bound-session-credentials",
    "device-bound-sessions",
    "session",
    "cookies",
    "security",
    "webappsec"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "default": "./dist/express.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "default": "./dist/hono.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./elysia": {
      "types": "./dist/elysia.d.ts",
      "default": "./dist/elysia.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "default": "./dist/fastify.js"
    },
    "./nestjs": {
      "types": "./dist/nestjs.d.ts",
      "default": "./dist/nestjs.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:zero-deps": "node scripts/check-zero-deps.mjs",
    "lint": "oxlint src tests scripts"
  },
  "devDependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "elysia": "^1.4.29",
    "express": "^5.2.1",
    "fastify": "^5.12.1",
    "hono": "^4.13.3",
    "oxlint": "^1.79.0",
    "publint": "^0.3.23",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": ">=0.28.1"
  }
}
